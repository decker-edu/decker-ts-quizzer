{
  "name": "decker-ts-quizzer",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./dist/server.js",
    "prebuild": "shx rm -rf dist",
    "build": "tsc",
    "postbuild": "shx cp -r ./views ./dist/views && shx cp -r ./public ./dist/public",
    "car": "npm run build && npm run start"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "express": "^4.18.3",
    "http-errors": "~1.6.3",
    "morgan": "~1.9.1",
    "pug": "^3.0.2",
    "socket.io": "^4.8.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.28",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.2"
  }
}
