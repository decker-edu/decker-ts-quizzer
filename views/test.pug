extends layout

block styles
  link(rel='stylesheet', href='./stylesheets/host.css')

block scripts
  script(src="./socket.io/socket.io.js")
  script(type="module", src="./javascripts/host.mjs") 
  script(src="./javascripts/wordcloud2.js")

block content
  header
    h1= title
  main
    div#host-area
      div.control-category
        h2 Set Quiz
        div#host-buttons.button-group
          button#choiceTestButton(type="button" disabled) Choice Quiz
          button#selectTestButton(type="button" disabled) Select Quiz
          button#freetextTestButton(type="button" disabled) Freetext Quiz
          button#assignmentTestButton(type="button" disabled) Assignment Quiz
      div.control-category
        h2 Control Quiz
        div#quiz-controls.button-group
          button#evaluateButton(type="button" disabled) Evaluate Quiz
      div.control-category
        h2 Control Socket
        div#socket-controls.button-group
          button#killButton(type="button" onclick="closeSocket()") Close Socket
      div#message-area
        h2 Messages
        pre#log
      div#canvas-area
        h2 Canvas Test