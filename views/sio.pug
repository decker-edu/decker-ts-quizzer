extends layout

block styles
  link(rel='stylesheet', href='./stylesheets/client.css')

block scripts
  script(src="./socket.io/socket.io.js")
  script(type="module", src="./javascripts/sio-client.mjs") 

block content
  div#connect-area
    input#session-id(type="text" placeholder="")
    button#connect-button(type="button" onclick="moduleConnect()") 
  div#quiz-area
    div#menu-area
      button#menu-button(onclick="openDialog()" aria-label="Share" title="Share")
        span.fa-solid.fa-share-from-square
    div#client-area
  dialog#share-dialog
    p
      span#menu-session-label
    canvas#menu-qr-code